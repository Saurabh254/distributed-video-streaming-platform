        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT count(*) AS total_users FROM users;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
