# Local-development credentials. Change these before starting.
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=change-this-minio-password

# Dedicated MinIO user for the full OpenMaxIO management console
CONSOLE_ADMIN_USER=consoleadmin
CONSOLE_ADMIN_PASSWORD=change-this-console-password

# Protect OpenMaxIO Console session/JWT payloads; use long independent random values
CONSOLE_PBKDF_PASSPHRASE=replace-with-a-long-random-passphrase
CONSOLE_PBKDF_SALT=replace-with-a-different-random-salt

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
