APP_ENV=development
DEBUG=true
PORT=8003
HOST=127.0.0.1
SERVICE_NAME=playback-service

# Database & Redis
PG_DSN=postgresql://postgres:12345678@localhost:5432/fineshare
REDIS_DSN=redis://localhost:6379/0

# Security (JWT secret shared across services)
JWT_SECRET_KEY=fineshare-super-secret-jwt-key-change-in-production-123456
JWT_ALGORITHM=HS256

# S3 / MinIO
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=localminio
S3_SECRET_KEY=12345678
S3_BUCKET=videos
S3_REGION=us-east-1

# Playback settings
VIEW_COUNT_THRESHOLD_SECONDS=5.0
SESSION_EXPIRY_SECONDS=86400

LOG_LEVEL=INFO
LOG_FORMAT=console
