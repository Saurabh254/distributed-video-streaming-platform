APP_ENV=development
PORT=8001
HOST=127.0.0.1
DEBUG=true

# Database and Cache
PG_DSN=postgresql://postgres:12345678@localhost:5432/fineshare
REDIS_DSN=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=fineshare-super-secret-jwt-key-change-in-production-123456
JWT_ALGORITHM=HS256

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=localminio
S3_SECRET_KEY=12345678
S3_BUCKET=videos
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRY_SECONDS=900

# Video upload limits
MAX_UPLOAD_SIZE_BYTES=5368709120

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
